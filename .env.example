# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# OpenRouter API Configuration (Server-side only — never expose OPENROUTER_API_KEY to browser)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_SITE_URL=""
OPENROUTER_APP_NAME="ORLIXA AI"

# AI Generation & Guardrails
AI_TEMPERATURE="0.7"
MAX_OUTPUT_TOKENS="2048"
MAX_MESSAGE_LENGTH="4000"
MAX_CONTEXT_MESSAGES="20"
AI_REQUEST_TIMEOUT_SECONDS="120"

# Security & Rate Limiting (Use "*" for all domains or comma-separated origins)
ALLOWED_ORIGINS="*"
RATE_LIMIT_REQUESTS_PER_MINUTE="20"
